# ============================================================
# EMC Talent Acquisition Portal - Environment Configuration
# Copy this file to .env and replace every placeholder value.
# NEVER commit real secrets.
# ============================================================

# ----- Runtime -----
NODE_ENV=development
PORT=4000
APP_NAME="EMC Talent Acquisition Portal"
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
DEFAULT_TIMEZONE=Asia/Kolkata

# ----- Database (Neon PostgreSQL - cloud) -----
# Production / cloud database. The `schema` parameter isolates the EMC Talent
# Acquisition tables inside the shared Neon database.
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&schema=emc_talent"
DATABASE_URL="postgresql://neondb_owner:REPLACE@ep-frosty-river-bdzur7d7-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&schema=emc_talent"

# ----- Authentication -----
JWT_SECRET=replace-with-a-64-character-random-string
JWT_EXPIRES_IN=12h
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMPLOYEE_INVITE_TTL_HOURS=72
SESSION_TTL_HOURS=12

# ----- Initial super admin (used by seed only) -----
SEED_SUPER_ADMIN_EMAIL=hr.admin@emc.example
SEED_SUPER_ADMIN_NAME="EMC HR Administrator"
# IT administrator: can sign in with OTP and password, and can reset HR accounts
SEED_IT_ADMIN_EMAIL=it.admin@emc.example
SEED_IT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ----- File storage (cloud bucket - Filebase / S3 compatible) -----
# s3 | google_drive | local (local is development only and blocked in production)
STORAGE_PROVIDER=s3
STORAGE_ALLOW_LOCAL=false
LOCAL_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=10
# Publicly reachable API base used to build links in emails
PUBLIC_API_URL=https://your-api-domain.com

# ----- Cloud bucket credentials (Filebase / AWS S3 / R2 / Spaces) -----
S3_ENDPOINT=https://s3.filebase.io
S3_REGION=auto
S3_BUCKET=hr-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ----- Google Drive (alternative cloud bucket) -----
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=

# ----- SMTP / Nodemailer -----
# When SMTP is not configured emails are simulated and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EMC Talent Acquisition <no-reply@emc.example>"
MAIL_REPLY_TO=hr@emc.example

# ----- AI / OCR -----
# Weights are percentages and must add up to 100.
AI_WEIGHT_SKILLS=35
AI_WEIGHT_EXPERIENCE=25
AI_WEIGHT_QUALIFICATION=15
AI_WEIGHT_DOMAIN=15
AI_WEIGHT_CERTIFICATION=10
OCR_ENABLED=true
OCR_LANGUAGES=eng
AI_TOP_RECOMMENDATIONS=10

# ----- Rate limiting + caching -----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# In-process cache for hot-path reads (dashboard, career listings, reports)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
# Short-TTL cache for resolved auth sessions (cuts 1-2 Neon round trips per API call)
AUTH_CACHE_ENABLED=true
AUTH_CACHE_TTL_SECONDS=30

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME="EMC Talent Acquisition Portal"
VITE_SUPPORT_EMAIL=hr@emc.example
