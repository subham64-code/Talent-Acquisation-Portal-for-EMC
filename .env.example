# ============================================================
# EMC WEBSITE + HR PORTAL - DEPLOYMENT CREDENTIALS / LINKS
# Copy this file to .env and fill only the values you have.
# ============================================================

# ---------- Live links (already deployed; do not change) ----------
DEPLOYED_SITE_URL=https://emc-website-7v6.pages.dev
DEPLOYED_SITE_ALIAS_URL=https://emc-website.emc-website-7v6.pages.dev
HR_PORTAL_URL=https://emc-talent-portal-bbd.pages.dev
HR_PORTAL_BRANCH_URL=https://emc-new-website.emc-talent-portal-bbd.pages.dev
HR_API_URL=https://talent-acquisation-portal-for-emc-production.up.railway.app/api/v1
LOCAL_SITE_URL=http://127.0.0.1:5500/EMC%20New%20Website/EMC/frontend/about.html

# ---------- HR portal backend (Railway service variables) ----------
# Production rejects localhost entries here. Local Live Server uses the
# deployed Pages API proxy, which already allows http://127.0.0.1:5500.
CORS_ORIGINS=https://emc-website-7v6.pages.dev,https://emc-website.emc-website-7v6.pages.dev,https://emc-talent-portal-bbd.pages.dev,https://emc-new-website.emc-talent-portal-bbd.pages.dev,https://emc-hr-frontend.pages.dev,https://www.ecometrix.co.in,https://ecometrix.co.in
APP_URL=https://emc-website-7v6.pages.dev
API_URL=https://talent-acquisation-portal-for-emc-production.up.railway.app/api/v1
CAREER_SITE_URL=https://emc-website-7v6.pages.dev/careers.html
TRACK_APPLICATION_URL=https://emc-website-7v6.pages.dev/track-application.html
DATABASE_URL=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
STORAGE_PROVIDER=s3
STORAGE_ALLOW_LOCAL=false
S3_FORCE_PATH_STYLE=true

# ---------- Cloudflare Pages Function (emc-website settings) ----------
# Needed only for Flask-only routes: /api/contact, /api/search,
# /api/newsletter/subscribe, /api/chat. Career apply works without it.
FLASK_API_ORIGIN=

# ---------- Neon S3-compatible object storage (website images + HR CV uploads) ----------
# Set these same S3_* values in the Railway HR service too; apply uploads fail with 500 without them.
S3_ENDPOINT=https://br-small-darkness-bd4lki66.storage.c-8.us-east-2.aws.neon.tech
S3_BUCKET=emc-bucket
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Local Flask backend (only when running backend/app.py) ----------
SECRET_KEY=emc_corporate_secret_key_2026
PORT=5000
